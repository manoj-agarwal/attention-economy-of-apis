            "type": "string",
            "enum": [
              "html",
              "wechat"
            ]
          },
          "footnoteLabel": {
            "default": "Footnotes",
            "description": "GFM 脚注区域标题",
            "type": "string",
            "maxLength": 50
          },
          "referenceTitle": {
            "default": "References",
            "description": "外部链接参考区域标题",
            "type": "string",
            "maxLength": 50
          }
        },
        "required": [
          "markdown"
        ]
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "description": "渲染后的 HTML 片段，CSS 样式已内联到元素上，可直接复制粘贴到富文本编辑器"
