        "type": "object",
        "properties": {
          "markdown": {
            "type": "string",
            "maxLength": 5242880,
            "description": "要渲染的 Markdown 源文本，支持 GFM（GitHub Flavored Markdown）语法、数学公式（$..$ 或 $$..$$）"
          },
          "markdownStyle": {
            "default": "ayu-light",
            "description": "Markdown 排版样式 ID",
            "type": "string",
            "enum": [
              "ayu-light",
              "bauhaus",
              "blueprint",
              "botanical",
              "green-simple",
              "kami",
              "maximalism",
              "neo-brutalism",
              "newsprint",
              "organic",
              "playful-geometric",
              "professional",
              "retro",
              "sketch",
              "terminal"
            ]
          },
          "codeTheme": {
            "default": "kimbie-light",
            "description": "代码块高亮主题 ID",
            "type": "string",
            "enum": [
              "catppuccin-frappe",
              "catppuccin-latte",
              "catppuccin-macchiato",
              "catppuccin-mocha",
              "kimbie-dark",
              "kimbie-light",
              "panda-syntax-dark",
              "panda-syntax-light",
              "paraiso-dark",
              "paraiso-light",
              "rose-pine",
              "rose-pine-dawn",
              "tokyo-night-dark",
              "tokyo-night-light"
            ]
          },
          "mermaidTheme": {
            "default": "",
            "description": "Mermaid 流程图主题 ID，空字符串表示使用默认主题",
            "type": "string",
            "enum": [
              "",
              "catppuccin-latte",
              "catppuccin-mocha",
              "dracula",
              "github-dark",
              "github-light",
              "nord",
              "nord-light",
              "one-dark",
              "solarized-dark",
              "solarized-light",
              "tokyo-night",
              "tokyo-night-light",
              "tokyo-night-storm",
              "zinc-dark",
              "zinc-light"
            ]
          },
          "infographicTheme": {
            "default": "default",
            "description": "Infographic 信息图主题 ID",
            "type": "string",
            "enum": [
              "default",
              "dark",
              "hand-drawn"
            ]
          },
          "infographicPalette": {
            "default": "antv",
            "description": "Infographic 信息图配色 ID",
            "type": "string",
            "enum": [
              "antv",
              "spectral"
            ]
          },
          "customCss": {
            "default": "",
            "description": "自定义 CSS 样式，在主题样式之后应用。选择器需约束在 #bm-md 下，例如：#bm-md h1 { color: red; }",
            "type": "string",
            "maxLength": 50000
          },
          "enableFootnoteLinks": {
            "default": true,
            "description": "是否将文中链接自动转换为脚注形式，便于阅读时查看原始链接",
            "type": "boolean"
          },
          "openLinksInNewWindow": {
            "default": true,
            "description": "是否为所有外部链接添加 target=\"_blank\"，在新窗口打开",
            "type": "boolean"
          },
          "platform": {
            "default": "html",
