      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "description": "转换后的 Markdown 文本，使用 - 作为无序列表标记"
          }
        },
        "required": [
          "result"
        ],
        "additionalProperties": false
      }
    },
