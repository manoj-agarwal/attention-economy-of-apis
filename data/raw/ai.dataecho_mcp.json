          },
          "ttlSeconds": {
            "type": "number",
            "description": "Expiry in seconds (null-like 0 not allowed; omit to keep)"
          },
          "password": {
            "type": "string",
            "description": "Password-gate the site; pass an empty string to REMOVE the password"
          }
