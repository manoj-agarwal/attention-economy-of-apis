{
  "name": "ai.dataecho/mcp",
  "source_url": "https://dataecho.ai/mcp",
  "fetched_at": "2026-08-10T02:30:55+00:00",
  "registry_description": "Deploy files, sites, and Dockerfile apps to live URLs + private drives for agent memory.",
  "tools": [
    {
      "name": "platform_info",
      "description": "DataEcho platform overview: what it can host, auth state of this connection, docs links. Call this first if unsure.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "request_login_code",
      "description": "Start sign-in: email a one-time code to the user. Follow with verify_login_code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The user's email address"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "verify_login_code",
      "description": "Complete sign-in with the emailed code. Returns the apiKey ONCE — configure it as the `Authorization: Bearer <key>` header of this MCP connection (and/or save to ~/.artifact/credentials for the CLI scripts). Never echo it into chat.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Same email as request_login_code"
          },
          "code": {
            "type": "string",
            "description": "The one-time code from the email"
          }
        },
        "required": [
          "email",
          "code"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "publish_site",
      "description": "Deploy files to a live URL. No slug → create a NEW site (works without auth; anonymous sites expire in 24h — always show the user the claimUrl). With slug → UPDATE that site (complete snapshot: send ALL files). A Dockerfile in the files makes it a server-side app (auth required; listen on process.env.PORT; persist under /data; poll app_status). Total payload ≤ 8 MB — for bigger sites use the dataecho skill scripts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "description": "Files to publish. Each file: { path, content (utf-8 text) OR contentBase64 (binary), contentType? }. The publish is a COMPLETE snapshot — omitted files are removed on update.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Site-relative path, e.g. index.html or assets/app.js"
                },
                "content": {
                  "type": "string",
                  "description": "UTF-8 text content (use for html/css/js/json/text)"
                },
                "contentBase64": {
                  "type": "string",
                  "description": "Base64 content (use for binary files)"
                },
                "contentType": {
                  "type": "string",
                  "description": "Optional MIME type; guessed from the extension if omitted"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "slug": {
            "type": "string",
            "description": "Existing site slug to update (omit to create a new site)"
          },
          "title": {
            "type": "string",
            "description": "Viewer page title (used when there's no index.html)"
          },
          "description": {
            "type": "string",
            "description": "Viewer page description"
          },
          "spa": {
            "type": "boolean",
            "description": "Enable SPA fallback routing (serve index.html for unknown paths)"
          },
          "ttlSeconds": {
            "type": "number",
            "description": "Expiry for authenticated sites, in seconds"
          },
          "claimToken": {
            "type": "string",
            "description": "Claim token — required to update an anonymous site without auth"
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "claim_site",
      "description": "Make a previously-anonymous site permanent under the authenticated account (requires auth + the claimToken from publish_site).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "Site slug"
          },
          "claimToken": {
            "type": "string",
            "description": "Claim token returned by the anonymous publish"
          }
        },
        "required": [
          "slug",
          "claimToken"
        ],
        "additionalProperties": false
      }
    },
