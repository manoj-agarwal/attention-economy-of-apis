                  "type": "string"
                },
                "disclosure": {
                  "type": "string"
                },
                "match_score": {
                  "type": "number"
                },
                "utm_params": {
                  "type": "object"
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "total_sponsored": {
                "type": "integer"
              },
              "auction_id": {
                "type": "string"
              },
